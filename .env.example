# ===== Neo4j =====
# NEO4J_AUTH và NEO4J_PASSWORD PHẢI trùng mật khẩu nhau, nếu không app không kết nối được.
# Mật khẩu tối thiểu 8 ký tự.
NEO4J_AUTH=neo4j/doi_mat_khau_nay
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=doi_mat_khau_nay

# ===== Airflow (http://localhost:8080) =====
# Tài khoản quản trị để đăng nhập giao diện Airflow. Đổi mật khẩu ở đây rồi chạy
# `docker compose up -d airflow` là mật khẩu được cập nhật.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=doi_mat_khau_nay

# ===== Đường dẫn trong container — không cần sửa =====
DATA_DIR=/app/data
OUT_DIR=/app/artifacts
DUCKDB_PATH=/app/artifacts/vienvien.duckdb

# ===== Tham số bài toán =====
# HORIZON, TOPK, MARKET_WEIGHT, DECISION_FREQ, trần bộ nhớ DuckDB... là hằng số cố
# định trong src/config.py — muốn đổi thì sửa ở đó, không đặt trong file này.
